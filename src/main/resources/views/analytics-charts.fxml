<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fitnesstraining.controller.AnalyticsChartsController"
      styleClass="memberships-root analytics-root"
      spacing="12"
      maxWidth="Infinity"
      maxHeight="Infinity">

    <HBox fx:id="feedbackBanner" styleClass="feedback-banner" alignment="CENTER" spacing="12" visible="false" managed="false">
        <Label fx:id="feedbackLabel" wrapText="true" HBox.hgrow="ALWAYS"/>
        <Button fx:id="feedbackDismissButton" text="×" onAction="#onDismissFeedback" styleClass="feedback-dismiss"/>
    </HBox>

    <VBox spacing="4" styleClass="analytics-header">
        <Label text="Gráficos" styleClass="section-title"/>
        <Label text="Vista visual de ocupación, ingresos, vencimientos y mora (mismos datos que Reportes)."
               styleClass="muted" wrapText="true"/>
    </VBox>

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                styleClass="analytics-charts-scroll" VBox.vgrow="ALWAYS">
        <VBox spacing="14" styleClass="panel-card list-panel analytics-tab-body">
            <padding>
                <Insets top="16" right="18" bottom="18" left="18"/>
            </padding>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="Actualizar gráficos" onAction="#onRefreshCharts" styleClass="primary-button"/>
            </HBox>

            <HBox spacing="12" styleClass="analytics-chart-row">
                <VBox spacing="6" HBox.hgrow="ALWAYS" styleClass="analytics-chart-card">
                    <Label text="Ocupación (últimos 14 días)" styleClass="field-label"/>
                    <StackPane fx:id="occupancyChartHost" styleClass="analytics-chart-host" minHeight="260" prefHeight="280"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS" styleClass="analytics-chart-card">
                    <Label text="Ingresos por tipo (últimos 30 días)" styleClass="field-label"/>
                    <StackPane fx:id="revenueChartHost" styleClass="analytics-chart-host" minHeight="260" prefHeight="280"/>
                </VBox>
            </HBox>

            <HBox spacing="12" styleClass="analytics-chart-row">
                <VBox spacing="6" HBox.hgrow="ALWAYS" styleClass="analytics-chart-card">
                    <Label text="Vencimientos por urgencia (próximos 14 días)" styleClass="field-label"/>
                    <StackPane fx:id="expiringChartHost" styleClass="analytics-chart-host" minHeight="240" prefHeight="260"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS" styleClass="analytics-chart-card">
                    <Label text="Mora por severidad" styleClass="field-label"/>
                    <StackPane fx:id="debtChartHost" styleClass="analytics-chart-host" minHeight="240" prefHeight="260"/>
                </VBox>
            </HBox>
        </VBox>
    </ScrollPane>
</VBox>
