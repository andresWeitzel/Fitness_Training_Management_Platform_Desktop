<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.fitnesstraining.controller.RoutineItemDetailController"
           styleClass="detail-window-frame"
           fx:id="rootPane"
           alignment="CENTER">

    <padding>
        <Insets top="16" right="16" bottom="20" left="16"/>
    </padding>

    <VBox spacing="12" styleClass="detail-window" prefWidth="400" minWidth="400" maxWidth="400">
        <padding>
            <Insets top="16" right="20" bottom="18" left="20"/>
        </padding>

        <HBox styleClass="window-drag" alignment="CENTER_LEFT" spacing="10">
            <Label text="Detalle del ejercicio" styleClass="detail-window-kicker" HBox.hgrow="ALWAYS"/>
            <Button text="×" onAction="#onClose" styleClass="window-close" focusTraversable="false"/>
        </HBox>

        <Label fx:id="titleLabel" styleClass="detail-window-title" wrapText="true"/>
        <Label fx:id="metaLabel" styleClass="detail-window-meta" wrapText="true"/>

        <Separator/>

        <VBox spacing="4">
            <Label text="Prescripción" styleClass="field-label"/>
            <Label fx:id="prescriptionLabel" styleClass="detail-window-body" wrapText="true"/>
        </VBox>

        <VBox spacing="4">
            <Label text="Descripción" styleClass="field-label"/>
            <Label fx:id="descriptionLabel" styleClass="detail-window-body" wrapText="true"/>
        </VBox>

        <VBox spacing="4">
            <Label text="Notas técnicas" styleClass="field-label"/>
            <Label fx:id="techniqueLabel" styleClass="detail-window-body" wrapText="true"/>
        </VBox>

        <Region minHeight="6"/>

        <HBox alignment="CENTER_RIGHT">
            <Button text="Cerrar" onAction="#onClose" styleClass="primary-button" prefWidth="120"/>
        </HBox>
    </VBox>
</StackPane>
