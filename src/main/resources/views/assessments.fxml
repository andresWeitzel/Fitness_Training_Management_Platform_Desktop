<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fitnesstraining.controller.AssessmentsController"
      styleClass="memberships-root"
      spacing="12"
      maxWidth="Infinity"
      maxHeight="Infinity">

    <VBox spacing="12" styleClass="panel-card list-panel" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="16" right="16" bottom="16" left="16"/>
        </padding>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="Historial de evaluaciones" styleClass="section-title"/>
                <Label fx:id="historyHintLabel" text="Seguimiento de peso, medidas e IMC. Use ⓘ para ver el detalle completo." styleClass="muted"/>
            </VBox>
            <Label fx:id="countLabel" styleClass="muted"/>
        </HBox>
        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="filter-chip-row">
            <Button fx:id="filterAllButton" text="Todas" onAction="#onFilterAll" styleClass="filter-chip chip-on"/>
            <Button fx:id="filter30Button" text="30 días" onAction="#onFilter30Days" styleClass="filter-chip"/>
            <Button fx:id="filter90Button" text="90 días" onAction="#onFilter90Days" styleClass="filter-chip"/>
        </HBox>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <ComboBox fx:id="historyClientCombo" promptText="Todos los clientes" prefWidth="260" styleClass="app-combo"/>
            <TextField fx:id="searchField" promptText="Filtrar por cliente o documento" HBox.hgrow="ALWAYS"/>
            <Button fx:id="registerForClientButton" text="Nueva evaluación" onAction="#onNewAssessment" styleClass="primary-button"/>
        </HBox>
        <TableView fx:id="assessmentsTable" VBox.vgrow="ALWAYS" styleClass="clients-table">
            <columns>
                <TableColumn fx:id="dateColumn" text="Fecha" prefWidth="110" minWidth="96"/>
                <TableColumn fx:id="clientColumn" text="Cliente" prefWidth="200" minWidth="140"/>
                <TableColumn fx:id="weightColumn" text="Peso" prefWidth="90" minWidth="72"/>
                <TableColumn fx:id="bmiColumn" text="IMC" prefWidth="80" minWidth="64"/>
                <TableColumn fx:id="fatColumn" text="Grasa (%)" prefWidth="90" minWidth="72"/>
                <TableColumn fx:id="assessorColumn" text="Evaluó" prefWidth="140" minWidth="100"/>
                <TableColumn fx:id="detailColumn" text="" prefWidth="52" minWidth="48" maxWidth="56"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
