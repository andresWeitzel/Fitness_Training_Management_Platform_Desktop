<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.fitnesstraining.controller.LoginController"
           styleClass="auth-canvas"
           alignment="CENTER">
    <padding>
        <Insets top="48" right="56" bottom="48" left="56"/>
    </padding>

    <VBox styleClass="auth-card" spacing="10" maxWidth="460" prefWidth="460" alignment="TOP_LEFT">
        <padding>
            <Insets top="36" right="40" bottom="36" left="40"/>
        </padding>

        <Label text="FT" styleClass="brand-mark"/>
        <Label text="FITNESS TRAINING" styleClass="eyebrow"/>
        <Label text="Iniciar sesión" styleClass="screen-title"/>
        <Label text="Plataforma de gestión para gimnasios y centros de entrenamiento."
               styleClass="muted"
               wrapText="true"/>

        <Label text="Usuario" styleClass="field-label"/>
        <TextField fx:id="usernameField" promptText="admin"/>

        <Label text="Contraseña" styleClass="field-label"/>
        <StackPane>
            <PasswordField fx:id="passwordField" promptText="1234"/>
            <TextField fx:id="visiblePasswordField" promptText="1234" managed="false" visible="false"/>
        </StackPane>
        <CheckBox fx:id="showPasswordCheck" text="Mostrar contraseña" styleClass="muted"/>

        <Label fx:id="errorLabel" styleClass="status-error" wrapText="true"/>
        <Label text="Desarrollo: admin / 1234  ·  empleado1 / emp123  ·  juan_prof / prof123  ·  maria_nutri / nutri123"
               styleClass="muted"
               wrapText="true"/>

        <Button fx:id="loginButton" text="Ingresar" onAction="#onLogin" maxWidth="Infinity" styleClass="primary-button"/>
        <Hyperlink text="Cambiar PostgreSQL" onAction="#onChangeDatabase" styleClass="subtle-link"/>
    </VBox>
</StackPane>
