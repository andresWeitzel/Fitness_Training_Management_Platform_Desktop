<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fitnesstraining.controller.ShellController"
            styleClass="shell-root">

    <left>
        <VBox styleClass="sidebar" spacing="0" prefWidth="216" minWidth="204" maxWidth="228">
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="sidebar-brand sidebar-drag window-drag">
                <padding>
                    <Insets top="18" right="12" bottom="18" left="12"/>
                </padding>
                <Label text="FT" styleClass="brand-mark-sm"/>
                <VBox spacing="2">
                    <Label text="FITNESS TRAINING" styleClass="brand"/>
                    <Label text="Management Platform" styleClass="brand-sub"/>
                </VBox>
            </HBox>

            <ScrollPane fx:id="navScroll" styleClass="sidebar-scroll" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                <VBox fx:id="navContainer" spacing="4" styleClass="sidebar-nav">
                    <padding>
                        <Insets top="6" right="10" bottom="10" left="10"/>
                    </padding>
                </VBox>
            </ScrollPane>

            <VBox spacing="0" styleClass="sidebar-footer">
                <padding>
                    <Insets top="10" right="10" bottom="12" left="10"/>
                </padding>
                <VBox spacing="8" styleClass="sidebar-session">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label fx:id="sidebarInitialLabel" styleClass="sidebar-avatar"/>
                        <VBox spacing="1" HBox.hgrow="ALWAYS">
                            <Label fx:id="sidebarUserLabel" styleClass="sidebar-user-name"/>
                            <Label fx:id="sidebarRoleLabel" styleClass="sidebar-user-role"/>
                        </VBox>
                    </HBox>
                    <Button text="Cerrar sesión" onAction="#onLogout" maxWidth="Infinity" styleClass="sidebar-logout"/>
                </VBox>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="0">
            <HBox styleClass="topbar window-drag" alignment="CENTER_LEFT" spacing="20">
                <padding>
                    <Insets top="12" right="18" bottom="12" left="10"/>
                </padding>
                <Label fx:id="pageTitle" text="Panel" styleClass="page-title" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <HBox spacing="6" alignment="CENTER">
                    <Button text="—" onAction="#onMinimize" styleClass="window-icon" focusTraversable="false"/>
                    <Button text="□" onAction="#onToggleMaximize" styleClass="window-icon" focusTraversable="false"/>
                    <Button text="×" onAction="#onClose" styleClass="window-close" focusTraversable="false"/>
                </HBox>
            </HBox>
            <ScrollPane fx:id="contentScroll" styleClass="content-scroll" fitToWidth="true"
                        hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                <StackPane fx:id="contentHost" styleClass="content-host" alignment="TOP_LEFT">
                    <padding>
                        <Insets top="14" right="18" bottom="18" left="8"/>
                    </padding>
                </StackPane>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
