<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.fitnesstraining.controller.DbSetupController"
           styleClass="auth-frame"
           alignment="TOP_CENTER"
           fx:id="rootPane">

    <VBox spacing="8" alignment="TOP_LEFT" styleClass="auth-card" prefWidth="440" maxWidth="440" maxHeight="-Infinity">
        <padding>
            <Insets top="14" right="28" bottom="22" left="28"/>
        </padding>

        <HBox styleClass="window-drag" alignment="CENTER_LEFT" spacing="8">
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="×" onAction="#onClose" styleClass="window-close" focusTraversable="false"/>
        </HBox>

        <HBox spacing="14" alignment="CENTER_LEFT">
            <Label text="FT" styleClass="brand-mark"/>
            <VBox spacing="2">
                <Label text="INSTALACIÓN" styleClass="eyebrow"/>
                <Label text="Configurar PostgreSQL" styleClass="screen-title"/>
            </VBox>
        </HBox>

        <Label text="Primera vez: crea la base si no existe, aplica migraciones Flyway y habilita el login."
               styleClass="muted"
               wrapText="true"/>

        <HBox spacing="12">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Servidor" styleClass="field-label"/>
                <TextField fx:id="hostField" promptText="localhost"/>
            </VBox>
            <VBox spacing="6" prefWidth="120">
                <Label text="Puerto" styleClass="field-label"/>
                <TextField fx:id="portField" promptText="5432"/>
            </VBox>
        </HBox>

        <Label text="Base de datos" styleClass="field-label"/>
        <TextField fx:id="databaseField" promptText="fitness_training"/>

        <Label text="Usuario" styleClass="field-label"/>
        <TextField fx:id="userField" promptText="postgres"/>

        <Label text="Contraseña" styleClass="field-label"/>
        <PasswordField fx:id="passwordField" promptText="postgres"/>

        <HBox fx:id="statusBox" spacing="10" alignment="TOP_LEFT" styleClass="connection-status-box" managed="false" visible="false">
            <ProgressIndicator fx:id="statusSpinner" prefWidth="18" prefHeight="18" managed="false" visible="false"/>
            <Label fx:id="statusLabel" wrapText="true" HBox.hgrow="ALWAYS"/>
        </HBox>

        <Button fx:id="testButton" text="Probar conexión" onAction="#onTestConnection" maxWidth="Infinity" styleClass="secondary-button"/>
        <Button fx:id="continueButton" text="Continuar al login" onAction="#onContinue" maxWidth="Infinity" styleClass="primary-button"/>
        <Button fx:id="backButton" text="Volver al login" onAction="#onBackToLogin" maxWidth="Infinity" styleClass="auth-action-button"/>
    </VBox>
</StackPane>
