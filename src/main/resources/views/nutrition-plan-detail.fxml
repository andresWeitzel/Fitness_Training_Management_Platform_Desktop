<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.fitnesstraining.controller.NutritionPlanDetailController"
           styleClass="detail-window-frame"
           alignment="CENTER">

    <VBox spacing="12" styleClass="detail-window" prefWidth="500" minWidth="500" maxWidth="500">
        <padding><Insets top="16" right="20" bottom="18" left="20"/></padding>
        <HBox styleClass="window-drag" alignment="CENTER_LEFT" spacing="10">
            <Label text="Plan nutricional" styleClass="detail-window-kicker" HBox.hgrow="ALWAYS"/>
            <Button text="×" onAction="#onClose" styleClass="window-close" focusTraversable="false"/>
        </HBox>
        <Label fx:id="titleLabel" styleClass="detail-window-title" wrapText="true"/>
        <Label fx:id="summaryLabel" styleClass="detail-window-meta" wrapText="true"/>
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="Estado" styleClass="field-label"/>
            <Label fx:id="statusLabel" styleClass="badge-ready"/>
        </HBox>
        <Label fx:id="validityLabel" styleClass="detail-window-meta"/>
        <Separator/>
        <VBox spacing="4">
            <Label text="Objetivos" styleClass="field-label"/>
            <Label fx:id="objectivesLabel" styleClass="detail-window-body" wrapText="true"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Guía alimentaria" styleClass="field-label"/>
            <Label fx:id="mealGuidanceLabel" styleClass="detail-window-body" wrapText="true"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Notas" styleClass="field-label"/>
            <Label fx:id="notesLabel" styleClass="detail-window-body" wrapText="true"/>
        </VBox>
        <HBox alignment="CENTER_RIGHT">
            <Button text="Cerrar" onAction="#onClose" styleClass="primary-button" prefWidth="120"/>
        </HBox>
    </VBox>
</StackPane>
