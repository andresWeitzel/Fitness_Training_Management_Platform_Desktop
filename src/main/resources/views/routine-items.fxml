<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.fitnesstraining.controller.RoutineItemsController"
           styleClass="detail-window-frame"
           fx:id="rootPane"
           alignment="CENTER">

    <VBox spacing="12" styleClass="detail-window routine-items-window">
        <padding>
            <Insets top="16" right="20" bottom="18" left="20"/>
        </padding>

        <HBox styleClass="window-drag" alignment="CENTER_LEFT" spacing="10">
            <Label text="Ejercicios de la rutina" styleClass="detail-window-kicker" HBox.hgrow="ALWAYS"/>
            <Button text="×" onAction="#onClose" styleClass="window-close" focusTraversable="false"/>
        </HBox>

        <Label fx:id="titleLabel" styleClass="detail-window-title" wrapText="true"/>
        <Label fx:id="summaryLabel" styleClass="detail-window-meta" wrapText="true"/>

        <VBox spacing="8" styleClass="routine-items-add">
            <Label text="Agregar ejercicio" styleClass="field-label"/>
            <ComboBox fx:id="itemExerciseCombo" promptText="Seleccione un ejercicio" maxWidth="Infinity" styleClass="app-combo"/>
            <HBox spacing="10" alignment="BOTTOM_LEFT">
                <VBox spacing="4">
                    <Label text="Series" styleClass="field-label"/>
                    <TextField fx:id="itemSetsField" promptText="3" prefWidth="72" minWidth="72"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="Reps" styleClass="field-label"/>
                    <TextField fx:id="itemRepsField" promptText="12" prefWidth="80" minWidth="80"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="Descanso (s)" styleClass="field-label"/>
                    <TextField fx:id="itemRestField" promptText="90" prefWidth="88" minWidth="88"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Carga / nota" styleClass="field-label"/>
                    <TextField fx:id="itemLoadField" promptText="Ligera, 20 kg…" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </VBox>
                <Button fx:id="addItemButton" text="Agregar" onAction="#onAddItem" styleClass="primary-button" minWidth="96" prefWidth="96"/>
            </HBox>
        </VBox>

        <TableView fx:id="itemsTable" prefHeight="240" minHeight="180" maxHeight="280" styleClass="clients-table routine-items-table" VBox.vgrow="NEVER">
            <columns>
                <TableColumn fx:id="itemNameColumn" text="Ejercicio" prefWidth="130" minWidth="100"/>
                <TableColumn fx:id="itemSetsColumn" text="Series" prefWidth="54" minWidth="48"/>
                <TableColumn fx:id="itemRepsColumn" text="Reps" prefWidth="58" minWidth="48"/>
                <TableColumn fx:id="itemRestColumn" text="Descanso" prefWidth="72" minWidth="64"/>
                <TableColumn fx:id="itemDetailColumn" text="" prefWidth="48" minWidth="44" maxWidth="52"/>
                <TableColumn fx:id="itemRemoveColumn" text="" prefWidth="48" minWidth="44" maxWidth="52"/>
                <TableColumn fx:id="itemLoadColumn" text="Carga / nota" prefWidth="110" minWidth="88"/>
            </columns>
        </TableView>

        <Label fx:id="statusLabel" styleClass="muted" wrapText="true"/>

        <HBox alignment="CENTER_RIGHT">
            <Button text="Cerrar" onAction="#onClose" styleClass="secondary-button" prefWidth="120"/>
        </HBox>
    </VBox>
</StackPane>
