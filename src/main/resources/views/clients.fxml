<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<SplitPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.fitnesstraining.controller.ClientsController"
           dividerPositions="0.50">

    <VBox spacing="14" styleClass="panel-card">
        <padding>
            <Insets top="22" right="22" bottom="22" left="22"/>
        </padding>
        <Label text="Listado" styleClass="section-title"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="searchField" promptText="Buscar por DNI, nombre o email" HBox.hgrow="ALWAYS"/>
            <Button text="Buscar" onAction="#onSearch" styleClass="secondary-button"/>
            <Button text="Nuevo" onAction="#onNew" styleClass="primary-button"/>
        </HBox>
        <TableView fx:id="clientsTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="documentColumn" text="Documento" prefWidth="120"/>
                <TableColumn fx:id="nameColumn" text="Cliente" prefWidth="200"/>
                <TableColumn fx:id="numberColumn" text="N° cliente" prefWidth="120"/>
                <TableColumn fx:id="statusColumn" text="Estado" prefWidth="100"/>
            </columns>
        </TableView>
    </VBox>

    <VBox spacing="8" styleClass="panel-card">
        <padding>
            <Insets top="22" right="22" bottom="22" left="22"/>
        </padding>
        <Label text="Ficha" styleClass="section-title"/>

        <Label text="Documento" styleClass="field-label"/>
        <TextField fx:id="documentField" promptText="DNI / documento"/>
        <HBox spacing="14">
            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label text="Nombre" styleClass="field-label"/>
                <TextField fx:id="firstNameField"/>
            </VBox>
            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label text="Apellido" styleClass="field-label"/>
                <TextField fx:id="lastNameField"/>
            </VBox>
        </HBox>
        <Label text="Email" styleClass="field-label"/>
        <TextField fx:id="emailField"/>
        <Label text="Teléfono" styleClass="field-label"/>
        <TextField fx:id="phoneField"/>
        <Label text="Dirección" styleClass="field-label"/>
        <TextField fx:id="addressField"/>

        <Label text="Credenciales de acceso" styleClass="section-title"/>
        <TextArea fx:id="credentialsArea" editable="false" prefRowCount="5" wrapText="true"/>

        <HBox spacing="10">
            <Button fx:id="issueCardButton" text="Emitir carnet" onAction="#onIssueCard" styleClass="secondary-button"/>
            <Button fx:id="renewCardButton" text="Renovar carnet" onAction="#onRenewCard" styleClass="secondary-button"/>
            <Button fx:id="issueQrButton" text="Generar QR" onAction="#onIssueQr" styleClass="secondary-button"/>
        </HBox>

        <Label fx:id="statusLabel" styleClass="muted" wrapText="true"/>

        <HBox spacing="10">
            <Button fx:id="saveButton" text="Guardar" onAction="#onSave" styleClass="primary-button"/>
            <Button fx:id="deactivateButton" text="Dar de baja" onAction="#onDeactivate" styleClass="danger-button"/>
        </HBox>
    </VBox>
</SplitPane>
