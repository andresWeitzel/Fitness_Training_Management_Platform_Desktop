<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<SplitPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.fitnesstraining.controller.ClientsController"
           dividerPositions="0.48"
           styleClass="clients-split">

    <VBox spacing="12" styleClass="panel-card">
        <padding>
            <Insets top="18" right="18" bottom="18" left="18"/>
        </padding>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Listado" styleClass="section-title" HBox.hgrow="ALWAYS"/>
            <Label fx:id="resultCountLabel" styleClass="muted"/>
        </HBox>
        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="filter-chip-row">
            <Button fx:id="filterActiveButton" text="Activos" onAction="#onFilterActive" styleClass="filter-chip chip-on"/>
            <Button fx:id="filterInactiveButton" text="Bajas" onAction="#onFilterInactive" styleClass="filter-chip"/>
            <Button fx:id="filterAllButton" text="Todos" onAction="#onFilterAll" styleClass="filter-chip"/>
        </HBox>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="searchField" promptText="Filtrar por DNI, nombre, email, teléfono o n°" HBox.hgrow="ALWAYS"/>
            <Button fx:id="newButton" text="Nuevo" onAction="#onNew" styleClass="primary-button"/>
        </HBox>
        <TableView fx:id="clientsTable" VBox.vgrow="ALWAYS" styleClass="clients-table">
            <columns>
                <TableColumn fx:id="documentColumn" text="Documento" prefWidth="110" minWidth="90"/>
                <TableColumn fx:id="nameColumn" text="Cliente" prefWidth="180" minWidth="140"/>
                <TableColumn fx:id="numberColumn" text="N° cliente" prefWidth="110" minWidth="90"/>
                <TableColumn fx:id="statusColumn" text="Estado" prefWidth="90" minWidth="80"/>
            </columns>
        </TableView>
    </VBox>

    <VBox spacing="8" styleClass="panel-card">
        <padding>
            <Insets top="18" right="18" bottom="18" left="18"/>
        </padding>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="Ficha" styleClass="section-title"/>
                <Label fx:id="fichaSubtitleLabel" styleClass="muted"/>
            </VBox>
            <Label fx:id="fichaStatusBadge" styleClass="badge-ready"/>
        </HBox>

        <Label text="Documento" styleClass="field-label"/>
        <TextField fx:id="documentField" promptText="DNI / documento"/>
        <HBox spacing="14">
            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label text="Nombre" styleClass="field-label"/>
                <TextField fx:id="firstNameField"/>
            </VBox>
            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label text="Apellido" styleClass="field-label"/>
                <TextField fx:id="lastNameField"/>
            </VBox>
        </HBox>
        <Label text="Email" styleClass="field-label"/>
        <TextField fx:id="emailField"/>
        <Label text="Teléfono" styleClass="field-label"/>
        <TextField fx:id="phoneField"/>
        <Label text="Dirección" styleClass="field-label"/>
        <TextField fx:id="addressField"/>

        <Label text="Credenciales de acceso" styleClass="section-title"/>
        <VBox fx:id="credentialsBox" spacing="8"/>

        <HBox spacing="10">
            <Button fx:id="issueCardButton" text="Emitir carnet" onAction="#onIssueCard" styleClass="secondary-button"/>
            <Button fx:id="renewCardButton" text="Renovar carnet" onAction="#onRenewCard" styleClass="secondary-button"/>
            <Button fx:id="issueQrButton" text="Generar QR" onAction="#onIssueQr" styleClass="secondary-button"/>
        </HBox>

        <Label fx:id="statusLabel" styleClass="muted" wrapText="true"/>

        <HBox spacing="10">
            <Button fx:id="saveButton" text="Guardar" onAction="#onSave" styleClass="primary-button"/>
            <Button fx:id="deactivateButton" text="Dar de baja" onAction="#onDeactivate" styleClass="danger-button"/>
        </HBox>
    </VBox>
</SplitPane>
