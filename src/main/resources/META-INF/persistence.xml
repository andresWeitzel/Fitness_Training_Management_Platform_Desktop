<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="fitness-pu" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>com.fitnesstraining.auth.model.User</class>
        <class>com.fitnesstraining.auth.model.Role</class>
        <class>com.fitnesstraining.auth.model.Permission</class>
        <class>com.fitnesstraining.members.model.Client</class>
        <class>com.fitnesstraining.members.model.AccessCredential</class>
        <class>com.fitnesstraining.memberships.model.MembershipPlan</class>
        <class>com.fitnesstraining.memberships.model.ClientMembership</class>
        <class>com.fitnesstraining.payments.model.Payment</class>
        <class>com.fitnesstraining.checkin.model.CheckIn</class>
        <class>com.fitnesstraining.training.model.Exercise</class>
        <class>com.fitnesstraining.training.model.TrainingRoutine</class>
        <class>com.fitnesstraining.training.model.TrainingRoutineItem</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="validate"/>
            <property name="hibernate.jdbc.time_zone" value="UTC"/>
        </properties>
    </persistence-unit>
</persistence>
